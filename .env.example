# AtlasDataPlatform — Environment Configuration
# Copy to .env and fill in values. Never commit real secrets.

# --- Platform ---
ATLAS_ENV=development
ATLAS_LOG_LEVEL=INFO
ATLAS_CACHE_TTL_HOURS=24
ATLAS_SCHEMA_VERSION=1.0.0
ATLAS_PLATFORM_VERSION=0.1.0

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=

# --- Reddit ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AtlasDataPlatform/1.0.0

# --- Google Trends ---
# (pytrends does not require a key, but geo/language can be set)
GOOGLE_TRENDS_GEO=
GOOGLE_TRENDS_LANGUAGE=en-US
GOOGLE_TRENDS_TIMEZONE=330

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=atlasdataplatform

# --- Collection limits (safety defaults) ---
MAX_YOUTUBE_CHANNELS=10
MAX_VIDEOS_PER_CHANNEL=15
MAX_COMMENTS_PER_VIDEO=30
MAX_REDDIT_SUBREDDITS=8
MAX_POSTS_PER_SUBREDDIT=50
MAX_COMMENTS_PER_POST=40
